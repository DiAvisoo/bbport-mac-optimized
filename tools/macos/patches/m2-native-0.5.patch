diff --git a/gpu/shadps4/video_core/cache_storage_worker.h b/gpu/shadps4/video_core/cache_storage_worker.h
new file mode 100644
index 0000000..ad53cf9
--- /dev/null
+++ b/gpu/shadps4/video_core/cache_storage_worker.h
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <condition_variable>
+#include <future>
+#include <mutex>
+#include <queue>
+#include "common/polyfill_thread.h"
+
+namespace Storage {
+
+// One mutex protects both the work and the wait predicate. A separate request counter
+// can lose an increment when the writer decrements it, or remain nonzero with no jobs.
+class CacheWriteQueue {
+public:
+    void Push(std::packaged_task<void()>&& job) {
+        {
+            std::scoped_lock lock{mutex};
+            jobs.emplace(std::move(job));
+        }
+        ready.notify_one();
+    }
+
+    bool WaitPop(std::packaged_task<void()>& job, std::stop_token stop) {
+        std::unique_lock lock{mutex};
+        Common::CondvarWait(ready, lock, stop, [&] { return !jobs.empty(); });
+        if (jobs.empty()) {
+            return false;
+        }
+        // Drain queued writes on shutdown so cache files are complete before close.
+        job = std::move(jobs.front());
+        jobs.pop();
+        return true;
+    }
+
+private:
+    std::mutex mutex;
+    std::condition_variable_any ready;
+    std::queue<std::packaged_task<void()>> jobs;
+};
+
+} // namespace Storage
diff --git a/gpu/shim/bbport_region_cache.h b/gpu/shim/bbport_region_cache.h
new file mode 100644
index 0000000..a18a401
--- /dev/null
+++ b/gpu/shim/bbport_region_cache.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+// Per-thread cache of mapping extents, invalidated by the runtime's mapping generation.
+// Draw preparation alternates between several heaps; one entry made all the workers
+// contend on the native process's shared mapping-table mutex for each switch.
+class BbMappedRegionCache {
+public:
+    bool Contains(std::uint64_t address, std::uint64_t size, std::uint64_t version) {
+        if ((version & 1) || version != generation || count == 0) return false;
+        const auto fits = [&](const Region& r) {
+            return address >= r.start && address < r.end && size <= r.end - address;
+        };
+        if (fits(regions[last])) return true;
+        for (std::size_t i = 0; i < count; ++i) {
+            if (i != last && fits(regions[i])) { last = i; return true; }
+        }
+        return false;
+    }
+    void Remember(std::uint64_t start, std::uint64_t end, std::uint64_t version) {
+        if ((version & 1) || start >= end) return;
+        if (generation != version) { generation = version; count = next = 0; }
+        regions[next] = {start, end};
+        last = next;
+        next = (next + 1) % regions.size();
+        if (count < regions.size()) ++count;
+    }
+private:
+    struct Region { std::uint64_t start = 0, end = 0; };
+    std::array<Region, 16> regions{};
+    std::uint64_t generation = 1;
+    std::size_t count = 0, next = 0, last = 0;
+};
